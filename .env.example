POSTGRES_USER=transcendence
POSTGRES_PASSWORD=transcendence_dev_password
POSTGRES_DB=transcendence
BACKEND_PORT=3000
FRONTEND_PORT=5173
APP_PORT=8080
APP_HTTPS_PORT=8443
HTTPS_REDIRECT=off

# HTTP / edge security
APP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080,https://localhost:8443,https://127.0.0.1:8443
HTTP_RATE_LIMIT_PER_MINUTE=300
WAF_SERVER_NAME=localhost

# File scanning
# real is the normal project mode: ClamAV locally + VirusTotal for PUBLIC files when a key is configured.
# development remains available for CI/tests.
# clamav and virustotal can still be selected for isolated provider testing.
SCAN_PROVIDER=real
MAX_FILE_SIZE_MB=25
SCANNER_HTTP_TIMEOUT_MS=30000
SCANNER_REFRESH_COOLDOWN_MS=60000
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_BASE_URL=https://www.virustotal.com/api/v3

# AI / LLM
# Put your real key only in .env. Never commit it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: OpenAI-compatible gateway/base URL.
OPENAI_BASE_URL=


# Account security / 2FA
# Use a random secret with at least 32 characters. Keep it stable once users enable 2FA.
TWO_FACTOR_ENCRYPTION_KEY=


# Optional file-mounted secrets (for Docker/Kubernetes/Vault-style secret injection).
# IMPORTANT: *_FILE values are FILE PATHS, never the secret itself.
# Example: OPENAI_API_KEY_FILE=/run/secrets/openai
# For normal local development, leave *_FILE blank and use OPENAI_API_KEY=... above.
VIRUSTOTAL_API_KEY_FILE=
OPENAI_API_KEY_FILE=
TWO_FACTOR_ENCRYPTION_KEY_FILE=
