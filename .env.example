POSTGRES_USER=transcendence
POSTGRES_PASSWORD=transcendence_dev_password
POSTGRES_DB=transcendence
BACKEND_PORT=3000
FRONTEND_PORT=5173
APP_HTTPS_PORT=8443

# HTTP / edge security
APP_ALLOWED_ORIGINS=https://localhost:8443,https://127.0.0.1:8443,http://localhost:5173,http://127.0.0.1:5173
HTTP_RATE_LIMIT_PER_MINUTE=300
WAF_SERVER_NAME=localhost

# File scanning
# real is the normal project mode: ClamAV locally + VirusTotal for PUBLIC files when a key is configured.
# development remains available for CI/tests.
# clamav and virustotal can still be selected for isolated provider testing.
SCAN_PROVIDER=real
MAX_FILE_SIZE_MB=25
SCANNER_HTTP_TIMEOUT_MS=30000
SCANNER_REFRESH_COOLDOWN_MS=60000
# Background worker that finishes running VirusTotal scans even when nobody has the report open.
# Interval in ms (0 disables), scans checked per interval, and the age after which a scan is marked failed.
SCAN_BACKGROUND_POLL_MS=30000
SCAN_BACKGROUND_POLL_BATCH=3
SCAN_MAX_RUNNING_MS=3600000
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_BASE_URL=https://www.virustotal.com/api/v3

# AI / LLM
# Put your real key only in .env. Never commit it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: OpenAI-compatible gateway/base URL.
OPENAI_BASE_URL=
# Requests per minute and per client for the AI assistant routes.
LLM_RATE_LIMIT_PER_MINUTE=10


# Secrets managed by HashiCorp Vault
# VIRUSTOTAL_API_KEY, OPENAI_API_KEY, TWO_FACTOR_ENCRYPTION_KEY and CLAIM_TOKEN_SECRET are
# stored in Vault at startup. The backend container never receives them as environment
# variables: it fetches them from Vault with its own read-only credentials.
# A value left empty is kept as it already is in Vault. The two keys below are generated
# automatically on first start when empty.

# Account security / 2FA
# At least 32 characters. Keep it stable once users enable 2FA.
# Generate one with: openssl rand -hex 32
TWO_FACTOR_ENCRYPTION_KEY=

# Signs the tokens that let an anonymous visitor claim their scans after signing up.
# At least 32 characters. Changing it invalidates unclaimed tokens.
# Generate one with: openssl rand -hex 32
CLAIM_TOKEN_SECRET=
